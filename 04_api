        optional :brand, type: String, desc: "Marca"
        optional :model, type: String, desc: "Modelo"
        optional :year, type: Integer, desc: "Año"
        optional :vin, type: String, desc: "VIN"
        optional :description, type: String, desc: "Descripción"
      end
      post do
