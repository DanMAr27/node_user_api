          plate: params[:plate],
          organizational_node_id: params[:organizational_node_id],
          brand: params[:brand],
          model: params[:model],
          year: params[:year],
          vin: params[:vin],
          description: params[:description]
        )

        if service.call
          present service.vehicle,
                  with: Entities::VehicleEntity,
                  include_location: true
        else
          error_response_from_service(service)
        end
